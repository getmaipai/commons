exports[`CHAT-CARDS-05 phone render snapshots band 1`] = `"<div style="width: 360px;"><div data-slot="answer-block" data-kind="band"><article data-slot="band" class="bg-background border border-border/60 dark:bg-popover flex w-full max-w-md flex-col gap-3 rounded-2xl p-4"><img alt="Lantern Hollow band portrait" loading="lazy" class="aspect-[4/3] w-full rounded-xl object-cover" src="hubimg-4f2a9c01"><div class="flex min-w-0 items-center gap-3"><img alt="Lantern Hollow logo" loading="lazy" class="size-14 shrink-0 rounded-xl object-cover" src="hubimg-5a3b0d12"><div class="min-w-0 flex-1"><h3 class="truncate text-[16px] font-semibold">Lantern Hollow</h3><p class="text-muted-foreground truncate text-xs">lo-fi · dream pop</p><p class="text-muted-foreground truncate text-xs">Inspired by a song that was playing</p></div></div><p class="text-[14px] leading-relaxed">Two friends who kept a lighthouse and wrote songs for the ships that never came.</p><ul class="flex flex-wrap gap-x-4 gap-y-2 text-xs"><li class="flex min-w-0 items-center gap-2"><span class="min-w-0"><span class="block truncate font-medium">Marlow Ash</span><span class="text-muted-foreground block truncate">vocals and keys</span></span></li><li class="flex min-w-0 items-center gap-2"><img alt="Nova Reed portrait" loading="lazy" class="size-8 shrink-0 rounded-full object-cover" src="hubimg-6c4d1e23"><span class="min-w-0"><span class="block truncate font-medium">Nova Reed</span><span class="text-muted-foreground block truncate">drums</span></span></li></ul><p data-slot="band-single" class="border-border/70 rounded-xl border px-3 py-2 text-xs"><span class="text-muted-foreground">First single</span> <span class="font-medium">Salt on the Glass</span></p><div class="flex flex-wrap gap-2 pt-1"><button type="button" disabled="" class="border-border/70 hover:bg-foreground/[0.05] focus-visible:ring-ring rounded-full border px-3 py-1.5 text-xs font-medium outline-none focus-visible:ring-2 disabled:cursor-default transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.96] motion-reduce:transition-none">make album</button><button type="button" disabled="" class="border-border/70 hover:bg-foreground/[0.05] focus-visible:ring-ring rounded-full border px-3 py-1.5 text-xs font-medium outline-none focus-visible:ring-2 disabled:cursor-default transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.96] motion-reduce:transition-none">remake logo</button><button type="button" disabled="" class="border-border/70 hover:bg-foreground/[0.05] focus-visible:ring-ring rounded-full border px-3 py-1.5 text-xs font-medium outline-none focus-visible:ring-2 disabled:cursor-default transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.96] motion-reduce:transition-none">keep</button><button type="button" disabled="" class="border-border/70 hover:bg-foreground/[0.05] focus-visible:ring-ring rounded-full border px-3 py-1.5 text-xs font-medium outline-none focus-visible:ring-2 disabled:cursor-default transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.96] motion-reduce:transition-none">discard</button></div></article></div></div>"`;
