{
  "schema": 1,
  "trace_policy": {
    "length": 6,
    "expires": true
  },
  "events": [
    {
      "name": "hub_start",
      "component": "hub",
      "description": "The hub finished starting.",
      "fields": []
    },
    {
      "name": "hub_stop",
      "component": "hub",
      "description": "The hub stopped.",
      "fields": []
    },
    {
      "name": "engine_ready",
      "component": "engine",
      "description": "A model engine became ready to serve.",
      "fields": []
    },
    {
      "name": "engine_error",
      "component": "engine",
      "description": "A model engine reported an error.",
      "fields": [
        {
          "name": "code",
          "type": "code"
        }
      ]
    },
    {
      "name": "turn_failures",
      "component": "turn",
      "description": "Hourly aggregate of turn-derived failures by component and code.",
      "fields": [
        {
          "name": "source",
          "type": "enum",
          "values": ["search", "tool"]
        },
        {
          "name": "code",
          "type": "code"
        },
        {
          "name": "count",
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    {
      "name": "search_degraded",
      "component": "search",
      "description": "Web search is running in a reduced state.",
      "fields": [
        {
          "name": "code",
          "type": "code"
        }
      ]
    },
    {
      "name": "backup_done",
      "component": "backup",
      "description": "A backup finished.",
      "fields": [
        {
          "name": "duration",
          "type": "duration"
        }
      ]
    },
    {
      "name": "backup_failed",
      "component": "backup",
      "description": "A backup failed.",
      "fields": [
        {
          "name": "code",
          "type": "code"
        }
      ]
    },
    {
      "name": "update_available",
      "component": "update",
      "description": "A newer version is available.",
      "fields": [
        {
          "name": "version",
          "type": "version"
        }
      ]
    },
    {
      "name": "log_rotated",
      "component": "log",
      "description": "The log files were rotated.",
      "fields": [
        {
          "name": "files",
          "type": "integer",
          "minimum": 0
        }
      ]
    }
  ]
}
