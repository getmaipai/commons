{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-fit-plan.schema.json",
  "title": "StackFitPlan",
  "description": "The Stack's answer to would this model fit this machine at this context, and what would it take. A wire record from the Stack to Home, never stored. Home words it for a person.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model",
    "context_tokens",
    "kv_cache_type",
    "roles",
    "total",
    "cap",
    "margin",
    "paths",
    "verdict",
    "bottleneck"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "context_tokens": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "kv_cache_type": {
      "$ref": "model-capabilities.schema.json#/$defs/kv_cache_type"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "choice",
          "peak"
        ],
        "properties": {
          "role": {
            "$ref": "model-capabilities.schema.json#/properties/role"
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "peak": {
            "$ref": "#/$defs/figure"
          }
        }
      }
    },
    "total": {
      "$ref": "#/$defs/figure"
    },
    "cap": {
      "$ref": "#/$defs/figure"
    },
    "margin": {
      "$ref": "#/$defs/figure"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "fits",
          "verdict"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path_name"
          },
          "fits": {
            "type": "boolean"
          },
          "verdict": {
            "$ref": "#/$defs/verdict"
          },
          "shortfall": {
            "$ref": "#/$defs/figure",
            "description": "Extra bytes needed for the smallest quantization to fit; absent when it fits."
          }
        }
      }
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    },
    "bottleneck": {
      "type": "string",
      "enum": [
        "memory",
        "disk",
        "context",
        "unknown"
      ]
    }
  },
  "$defs": {
    "known_figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "source",
        "as_of"
      ],
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": [
            "measured",
            "dry-run",
            "estimated"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "unknown_figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "source",
        "as_of"
      ],
      "properties": {
        "low": {
          "type": "null"
        },
        "high": {
          "type": "null"
        },
        "source": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "figure": {
      "anyOf": [
        {
          "$ref": "#/$defs/known_figure"
        },
        {
          "$ref": "#/$defs/unknown_figure"
        }
      ],
      "description": "Bytes; a range with its source and date, never a bare number; unknown is a first-class answer and is never filled with a guess."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "yes",
        "slow",
        "no",
        "unknown"
      ],
      "description": "slow means the cpu-offload path is the only one that fits; unknown means no measured record, dry run or verified architecture exists for this model."
    },
    "path_name": {
      "type": "string",
      "enum": [
        "unified",
        "gpu",
        "multi-gpu",
        "cpu-offload",
        "cpu"
      ]
    }
  }
}
