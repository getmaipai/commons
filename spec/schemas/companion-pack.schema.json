{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/companion-pack.schema.json",
  "title": "CompanionPack",
  "description": "PACK-01: a portable animation and expression pack for one companion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "tile", "states", "mouth", "eyes", "emotion", "life", "budget", "provenance"],
  "properties": {
    "version": {"type":"integer", "const":1},
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9-]*$"},
    "name": {"type":"string", "minLength":1},
    "tile": {"type":"object", "additionalProperties":false, "minProperties":1, "properties":{"desktop":{"type":"integer","const":480},"phone":{"type":"integer","const":320}}},
    "states": {"type":"object","additionalProperties":false,"required":["idle","listen","think","speak"],"properties":{"idle":{"$ref":"#/$defs/idle"},"listen":{"$ref":"#/$defs/clips"},"think":{"$ref":"#/$defs/clips"},"speak":{"$ref":"#/$defs/clips"}}},
    "mouth": {"$ref":"#/$defs/mouth"},
    "eyes": {"$ref":"#/$defs/eyes"},
    "emotion": {"type":"object","additionalProperties":false,"required":["angry","excited","alarmed","sad"],"properties":{"angry":{"$ref":"#/$defs/emotionKind"},"excited":{"$ref":"#/$defs/emotionKind"},"alarmed":{"$ref":"#/$defs/emotionKind"},"sad":{"$ref":"#/$defs/emotionKind"}}},
    "life": {"type":"object","additionalProperties":false,"required":["nod","brow","gazeL","gazeR","gazeU","eyeWide","eyeSquint","eyeClosed","eyeHalf","mCorner","mAsymL","mAsymR","mUpper","mPress","mNostril","mWrinkle","smile","mBrow"],"properties":{"nod":{"type":"number"},"brow":{"type":"number"},"gazeL":{"type":"number"},"gazeR":{"type":"number"},"gazeU":{"type":"number"},"eyeWide":{"type":"number"},"eyeSquint":{"type":"number"},"eyeClosed":{"type":"number"},"eyeHalf":{"type":"number"},"mCorner":{"type":"number"},"mAsymL":{"type":"number"},"mAsymR":{"type":"number"},"mUpper":{"type":"number"},"mPress":{"type":"number"},"mNostril":{"type":"number"},"mWrinkle":{"type":"number"},"smile":{"type":"number"},"mBrow":{"type":"number"}}},
    "budget": {"type":"object","additionalProperties":false,"required":["bytes"],"properties":{"bytes":{"type":"integer","minimum":1,"maximum":12582912}}},
    "provenance": {"$ref":"#/$defs/provenance"}
  },
  "$defs": {
    "box": {"type":"object","additionalProperties":false,"required":["x","y","w","h"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"w":{"type":"number","exclusiveMinimum":0},"h":{"type":"number","exclusiveMinimum":0}}},
    "clip": {"type":"object","additionalProperties":false,"required":["id","file","fps","frames","rest","track","encoding"],"properties":{"id":{"type":"string","minLength":1},"file":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*\\.webm$).+\\.mp4$"},"fps":{"type":"number","exclusiveMinimum":0},"frames":{"type":"integer","minimum":1},"rest":{"type":"object","additionalProperties":false,"required":["first","last"],"properties":{"first":{"type":"integer","minimum":0},"last":{"type":"integer","minimum":0}}},"track":{"type":"array","minItems":1,"items":{"type":"number"}},"encoding":{"type":"string","const":"stacked-alpha-h264"},"weight":{"type":"number","minimum":0}}},
    "clips": {"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/clip"}},
    "idle": {"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/clip"}},
    "mouth": {"type":"object","additionalProperties":false,"required":["shapes","grid","letters","flows","anchor"],"properties":{"shapes":{"type":"string","minLength":1},"grid":{"type":"object","additionalProperties":false,"required":["cols","rows","tile"],"properties":{"cols":{"type":"integer","minimum":1},"rows":{"type":"integer","minimum":1},"tile":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}}}}},"letters":{"type":"object","additionalProperties":false,"required":["A","B","C","D","E","F","G","H","wide"],"properties":{"A":{"type":"integer","minimum":0},"B":{"type":"integer","minimum":0},"C":{"type":"integer","minimum":0},"D":{"type":"integer","minimum":0},"E":{"type":"integer","minimum":0},"F":{"type":"integer","minimum":0},"G":{"type":"integer","minimum":0},"H":{"type":"integer","minimum":0},"wide":{"type":"integer","minimum":0}}},"flows":{"type":"object","additionalProperties":false,"required":["file","flowScale"],"properties":{"file":{"type":"string","minLength":1},"flowScale":{"type":"number","exclusiveMinimum":0}}},"anchor":{"$ref":"#/$defs/box"},"warp":{"type":"string","minLength":1}}},
    "eyePicture": {"type":"object","additionalProperties":false,"required":["file","box"],"properties":{"file":{"type":"string","minLength":1},"box":{"$ref":"#/$defs/box"}}},
    "eyes": {"type":"object","additionalProperties":false,"required":["closed","half"],"properties":{"closed":{"$ref":"#/$defs/eyePicture"},"half":{"$ref":"#/$defs/eyePicture"},"wide":{"$ref":"#/$defs/eyePicture"}}},
    "emotionKind": {"type":"object","additionalProperties":false,"required":["flow","residual","region","flowFull"],"properties":{"flow":{"type":"string","minLength":1},"residual":{"type":"string","minLength":1},"region":{"$ref":"#/$defs/box"},"flowFull":{"type":"number","minimum":0}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["maker","makerVersion","source","created"],"properties":{"maker":{"type":"string","minLength":1},"makerVersion":{"type":"string","minLength":1},"source":{"type":"string","enum":["photo","stylised","generated"]},"created":{"type":"string","format":"date-time"}}}
  }
}
