{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/tour.schema.json",
  "title": "Tour",
  "description": "A short, package-declared guided tour. Cross-field child-copy and hero-slide existence checks are enforced by the spec tour validator; hero_slide lookup may also be performed by Home's validator when slide data is available.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "audience", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "starts_on": { "type": "string", "minLength": 1 },
    "audience": { "type": "array", "items": { "type": "string", "enum": ["adult", "teen", "child"] }, "minItems": 1, "uniqueItems": true },
    "steps": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "placement", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "hero_slide": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^—]*$" },
        "body": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "^[^—]*$" },
        "title_by_audience": { "$ref": "#/$defs/audience_copy" },
        "body_by_audience": { "$ref": "#/$defs/audience_copy" },
        "placement": { "type": "string", "enum": ["top", "bottom", "left", "right", "auto", "center"] },
        "order": { "type": "integer", "minimum": 0 },
        "condition": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "roles": { "type": "array", "items": { "type": "string", "enum": ["owner", "admin", "adult", "teen", "child", "guest"] }, "minItems": 1, "uniqueItems": true },
            "setting": { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "type": "string", "minLength": 1 }, "value": {} } },
            "capability": { "type": "string", "minLength": 1 },
            "surface": { "type": "string", "enum": ["desktop", "phone"] }
          }
        }
      },
      "required": []
    },
    "audience_copy": { "type": "object", "additionalProperties": false, "properties": { "teen": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "^[^—]*$" }, "child": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "^[^—]*$" } } }
  }
}
