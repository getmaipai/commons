{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/coding-session.schema.json",
  "title": "CodingSession",
  "description": "CODE-SPEC-01 and CODE-TIER-01 (Home docs/design/local-coding-2026-10-17.md section 4.2, code-session-tiers-2026-11-21.md section 3.1). One Code app session, person scope and owner only. `tier` is the person's stored choice and holds across turns and restarts; each turn still clamps it to what the person may run, and Home writes the corrected value back. `model_id` is provenance, never a choice: Home writes the model that answered the last turn from the Stack's reply and never maps a tier to a model. The transcript is the session's message list in the chat message-part shape and is stored like a conversation, not in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "title",
    "repo",
    "environment_id",
    "mode",
    "state",
    "network",
    "usage",
    "changes",
    "created_at",
    "last_activity_at",
    "provenance",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^csess-[a-z0-9]{6,}$"
    },
    "person_id": {
      "type": "string",
      "pattern": "^person-[a-z0-9]{6,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_branch",
        "work_branch"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "github",
            "gitea",
            "hub_folder",
            "none"
          ]
        },
        "connection_id": {
          "type": "string",
          "pattern": "^gitc-[a-z0-9]{6,}$",
          "description": "The git-connection used for github and gitea repositories."
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "owner/name on the git host."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Relative path inside the household folder, for hub_folder."
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "work_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "environment_id": {
      "type": "string",
      "pattern": "^cenv-[a-z0-9]{6,}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "plan",
        "ask",
        "auto_edit"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "working",
        "needs_you",
        "idle",
        "paused",
        "done",
        "failed",
        "archived"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "standard",
        "boost",
        "max"
      ],
      "default": "standard",
      "description": "The person's stored choice. Switching writes it at once and takes effect at the next turn, never in the middle of one. Reduced is applied by the system only and is never stored here."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "hosts"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "none",
            "hosts"
          ],
          "description": "none: the sandbox reaches only the gateway. hosts: it also reaches the listed hosts through the egress proxy."
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      }
    },
    "mounts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^file-[a-z0-9]{6,}$"
      },
      "description": "Household storage file ids mounted read only."
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Provenance written by Home from the Stack's reply: the catalog id of the model that answered the last turn. Absent before the first turn. Never a choice and never read to pick a model."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "additions",
        "deletions"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pull_request": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "url",
        "number",
        "draft"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "label",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "files": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "trash_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node."
    }
  }
}
