{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/status-note.schema.json",
  "title": "StatusNote",
  "description": "One plain-text note an admin pins to the status page. At most one uncleared, unexpired note is shown at a time; that is a display rule, not enforceable in this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "body", "posted_by", "posted_at", "hlc"],
  "properties": {
    "id": { "type": "string", "pattern": "^note-[a-z0-9]{6,}$" },
    "body": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Plain text only, with no markup." },
    "posted_by": { "type": "string", "pattern": "^person-[a-z0-9]{6,}$" },
    "posted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "cleared_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "cleared_by": { "type": ["string", "null"], "pattern": "^person-[a-z0-9]{6,}$", "default": null },
    "hlc": { "type": "string", "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$", "description": "Hybrid logical clock: wall_ms:counter:node." }
  }
}
