{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/robot-offer.schema.json",
  "title": "RobotOffer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "tier",
    "text",
    "expires_at",
    "provenance",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "person_id": {
      "type": "string",
      "pattern": "^person-[a-z0-9]{6,}$"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    }
  }
}
