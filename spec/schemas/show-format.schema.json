{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "show-format.schema.json",
  "title": "ShowFormat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "parts",
    "structure",
    "length_s",
    "talk_over",
    "gap_ms",
    "sources_allowed",
    "min_audience",
    "substitute",
    "stingers",
    "words_per_minute",
    "first_app"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "label": {
      "type": "string",
      "maxLength": 40
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "min",
          "max",
          "leads",
          "dials"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 0
          },
          "leads": {
            "type": "boolean"
          },
          "dials": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "formality": {
                "enum": [
                  "casual",
                  "neutral",
                  "formal"
                ]
              },
              "complexity": {
                "enum": [
                  "simple",
                  "standard",
                  "advanced"
                ]
              },
              "engagement": {
                "enum": [
                  "brief",
                  "balanced",
                  "curious"
                ]
              },
              "filler_density": {
                "enum": [
                  "none",
                  "light",
                  "frequent"
                ]
              },
              "clock_style": {
                "enum": [
                  "formal",
                  "plain",
                  "loose"
                ]
              },
              "hedging": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "social": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "humor": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "warmth": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "initiative": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "share"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hook",
              "intro",
              "segment",
              "exchange",
              "closing"
            ]
          },
          "share": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "repeat": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "length_s": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "default",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer"
        },
        "default": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "talk_over": {
      "enum": [
        "none",
        "light",
        "lively",
        "heated"
      ]
    },
    "gap_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "sources_allowed": {
      "type": "array",
      "items": {
        "enum": [
          "news",
          "weather",
          "household",
          "documents",
          "media_item",
          "bookmarks"
        ]
      }
    },
    "min_audience": {
      "enum": [
        "all",
        "teen",
        "adult"
      ]
    },
    "substitute": {
      "enum": [
        "stand_in",
        "skip"
      ]
    },
    "stingers": {
      "type": "boolean"
    },
    "words_per_minute": {
      "type": "integer",
      "minimum": 100,
      "maximum": 220
    },
    "first_app": {
      "type": "string"
    }
  }
}
