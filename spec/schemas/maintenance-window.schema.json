{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/maintenance-window.schema.json",
  "title": "MaintenanceWindow",
  "description": "Scheduled maintenance. Status is derived at read time from the clock and cancelled_at (scheduled -> in_progress -> completed, or cancelled), never stored. ends_at must be after starts_at; JSON Schema cannot express this, so the hub enforces it. Recurring windows store an RFC 5545 RRULE in rrule, an optional inclusive end date in until, and the occurrence duration is ends_at minus starts_at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "components", "starts_at", "ends_at", "created_by", "created_at", "hlc"],
  "properties": {
    "id": { "type": "string", "pattern": "^maint-[a-z0-9]{6,}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "status-component.schema.json" } },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "pattern": "^person-[a-z0-9]{6,}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "hlc": { "type": "string", "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$", "description": "Hybrid logical clock: wall_ms:counter:node." },
    "description": { "type": "string", "maxLength": 1000, "default": "" },
    "cancelled_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "rrule": { "type": "string", "minLength": 1 },
    "until": { "type": "string", "format": "date" }
  }
}
