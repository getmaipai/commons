{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/content-rating.schema.json",
  "title": "ContentRating",
  "description": "The one stamp every rated item and result carries. It sits beside content-ceiling.schema.json, which governs the register of a generated reply per band and is unchanged. A viewer's ceiling is a rank from 0 to 4 in Home's design.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "level": { "type": "string", "enum": ["G", "PG", "PG-13", "R", "X", "Prohibited", "Unrated"] },
    "source": {
      "type": "string",
      "enum": ["given", "declared", "worked_out"],
      "description": "given means an outside label such as a film rating, explicit flag, or site list; declared means the feature that made the content says what it can only make; worked_out means one of our own raters decided."
    },
    "rater": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "The rater id." },
    "rater_version": { "type": "integer", "minimum": 1 },
    "rated_at": { "type": "string", "format": "date-time" },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["swearing", "drugs", "gambling", "gore", "sexual", "minor_line", "scary", "self_harm"] },
      "description": "The first six are Home's content-policy protection kinds; scary and self_harm come from the design note."
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "required": ["system", "value"],
      "description": "The outside label this stamp was mapped from."
    }
  },
  "required": ["level", "source", "rater", "rater_version", "rated_at"],
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "given" } }, "required": ["source"] },
      "then": {},
      "else": { "not": { "required": ["label"] } }
    },
    {
      "if": { "properties": { "level": { "const": "Prohibited" } }, "required": ["level"] },
      "then": { "properties": { "reasons": { "contains": { "const": "minor_line" } } }, "required": ["reasons"] }
    },
    {
      "if": { "properties": { "level": { "const": "Unrated" } }, "required": ["level"] },
      "then": { "properties": { "reasons": { "maxItems": 0 } } }
    }
  ]
}
