{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/media-source.schema.json",
  "title": "MediaSource",
  "description": "MEDIA-SPEC-01 (media design section 7). Where media items come from: a library root folder on the hub or a mounted share, a podcast feed, a web channel followed at a person's pace, or a pasted link. Roots of different kinds may not overlap (enforced at save). A child never adds a source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "scope",
    "label",
    "created_at",
    "hlc",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msrc-[a-z0-9]{6,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "root",
        "feed",
        "channel",
        "link"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "household",
        "person"
      ]
    },
    "owner_person_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^person-[a-z0-9]{6,}$",
      "default": null,
      "description": "Set when scope is person; the adult who created a household source otherwise (for saved copies' ownership)."
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "default": null,
      "required": [
        "path",
        "kinds"
      ],
      "properties": {
        "mount_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "A nas_mounts row when the folder is on a mounted share; null for a folder on the hub's own disk."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "video",
              "episode",
              "film",
              "track",
              "book",
              "audiobook"
            ]
          }
        }
      }
    },
    "feed_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "For kind feed: the feed record (purpose podcast)."
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "default": null,
      "description": "For a channel or a link. Never logged; excluded from an export when it carries a token."
    },
    "extractor": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "auto": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "save": "none",
        "keep_latest": null,
        "remove_watched": false,
        "max_per_check": 2,
        "max_duration_s": null,
        "min_duration_s": null,
        "skip_shorts": true,
        "cutoff_date": null,
        "quality_max_height": null
      },
      "required": [
        "save"
      ],
      "properties": {
        "save": {
          "type": "string",
          "enum": [
            "none",
            "audio",
            "video"
          ]
        },
        "keep_latest": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "remove_watched": {
          "type": "boolean",
          "default": false
        },
        "max_per_check": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        },
        "max_duration_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "min_duration_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null
        },
        "skip_shorts": {
          "type": "boolean",
          "default": true
        },
        "cutoff_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "default": null
        },
        "quality_max_height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 144,
          "default": null
        }
      }
    },
    "speed": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.5,
      "maximum": 3,
      "default": null,
      "description": "Per-source playback speed (podcasts). Null uses the person's audio.speed key."
    },
    "skip_intro_s": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "skip_outro_s": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "poll_minutes": {
      "type": "integer",
      "minimum": 15,
      "default": 60
    },
    "paused": {
      "type": "boolean",
      "default": false
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "last_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ok",
        "failed",
        "quiet",
        "root_missing",
        null
      ],
      "default": null
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "backoff_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "visible_to": {
      "oneOf": [
        {
          "type": "string",
          "const": "household"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^person-[a-z0-9]{6,}$"
          },
          "uniqueItems": true
        }
      ],
      "default": "household"
    },
    "archive": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "\"Deleted stays gone\": the external ids (or root paths) of items a person deleted, so a re-poll or a re-scan never brings them back."
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null,
      "description": "TRASH-01. Set when a person moves the record to the household trash; null while live. A trashed record is hidden everywhere and restorable until trash_until."
    },
    "trash_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null,
      "description": "TRASH-01. When the trash purges the record for good; set together with deleted_at."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node (7.3)."
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
