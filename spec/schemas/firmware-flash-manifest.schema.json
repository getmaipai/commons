{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/firmware-flash-manifest.schema.json",
  "title": "FirmwareFlashManifest",
  "description": "Signed firmware image layout for browser-based flashing. Offsets are supplied by the manifest producer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "builds",
    "flash_size",
    "provenance",
    "created_at",
    "hlc",
    "signature"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chipFamily",
          "parts"
        ],
        "properties": {
          "chipFamily": {
            "type": "string",
            "enum": [
              "ESP32",
              "ESP32-C3",
              "ESP32-C6",
              "ESP32-S2",
              "ESP32-S3",
              "ESP8266"
            ]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "offset",
                "size",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\\\]+$"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "flash_size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*MB$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyid",
        "sig"
      ],
      "properties": {
        "keyid": {
          "type": "string",
          "minLength": 1
        },
        "sig": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
