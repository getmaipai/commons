{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/news-save.schema.json",
  "title": "NewsSave",
  "description": "NEWS-00. One story a person saved. Person scope. A saved item's article text and picture are exempt from the shelf prune while the save exists. `offline` is true once the text and the picture are cached.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "item_id",
    "story_id",
    "canonical_url",
    "title",
    "publisher",
    "saved_at",
    "offline",
    "hlc",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^save-[a-z0-9]{6,}$"
    },
    "person_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "pattern": "^news-[a-z0-9]{6,}$"
    },
    "story_id": {
      "type": "string",
      "pattern": "^story-[a-z0-9]{6,}$"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "offline": {
      "type": "boolean"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node (7.3)."
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
