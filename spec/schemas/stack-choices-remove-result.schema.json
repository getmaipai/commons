{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-choices-remove-result.schema.json",
  "title": "StackChoicesRemoveResult",
  "description": "STACK-MODELS-PAGE-01. One line per id (removed, kept or failed, with a plain sentence), what the tidy removed and the space freed.",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "removed",
              "kept",
              "failed"
            ]
          },
          "freed_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "freed_bytes",
          "message"
        ]
      }
    },
    "tidy_removed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "bytes"
        ]
      }
    },
    "freed_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kept": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "results",
    "tidy_removed",
    "freed_bytes",
    "kept",
    "failed"
  ]
}
