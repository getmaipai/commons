{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/media-production.schema.json",
  "title": "MediaProduction",
  "description": "MEDIA-01. A private, shareable container for kind-agnostic media production: cast roles, sets, props, script structure, source media and finished cuts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "owner_person_id",
    "shared_to",
    "cast",
    "sets",
    "props",
    "episodes",
    "clip_file_ids",
    "picture_file_ids",
    "music_line_ids",
    "voice_line_ids",
    "finished_cut_file_ids",
    "provenance",
    "created_at",
    "updated_at",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mprd-[a-z0-9]{6,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "default": ""
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^person-[a-z0-9]{6,}$"
    },
    "shared_to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^person-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cast"
      },
      "default": []
    },
    "sets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^msub-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "props": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^msub-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      },
      "default": []
    },
    "clip_file_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^file-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "picture_file_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^file-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "music_line_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^musicline-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "voice_line_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^voiceline-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "finished_cut_file_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^file-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    },
    "show": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "format_id",
        "audience",
        "household_facts",
        "sources",
        "schedule",
        "length_s"
      ],
      "properties": {
        "format_id": {
          "type": "string",
          "enum": [
            "news_briefing",
            "kids_news",
            "round_table",
            "debate",
            "review",
            "discussion",
            "dj_links",
            "narration",
            "announcer"
          ]
        },
        "audience": {
          "type": "string",
          "enum": [
            "all",
            "teen",
            "adult"
          ]
        },
        "household_facts": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "news",
                  "weather",
                  "household",
                  "documents",
                  "media_item",
                  "bookmarks"
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                },
                "default": []
              },
              "file_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^file-[a-z0-9]{6,}$"
                },
                "default": []
              },
              "media_item_id": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            }
          }
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": false,
          "required": [
            "every",
            "at"
          ],
          "properties": {
            "every": {
              "type": "string",
              "enum": [
                "1d",
                "7d"
              ]
            },
            "at": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "days": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "default": []
            }
          }
        },
        "length_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        },
        "state": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": false,
          "properties": {
            "episode_id": {
              "type": "string"
            },
            "stage": {
              "type": "string",
              "enum": [
                "brief",
                "outline",
                "script",
                "check",
                "voices",
                "mix",
                "keep",
                "done",
                "failed"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "last_make_ms": {
              "type": [
                "integer",
                "null"
              ],
              "default": null
            }
          }
        },
        "stand_in_synth_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    }
  },
  "$defs": {
    "cast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "role"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^msub-[a-z0-9]{6,}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "wardrobe_variant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^msub-[a-z0-9]{6,}$"
          },
          "default": []
        },
        "voice_choice": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "default": null
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        },
        "synth_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "default": null
        },
        "part": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "anchor",
            "reporter",
            "host",
            "co_host",
            "guest",
            "moderator",
            "side",
            "critic",
            "dj",
            "narrator",
            "announcer",
            "actor",
            null
          ],
          "default": null
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "default": []
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shot"
          },
          "default": []
        },
        "act": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "CREATOR-01. Optional act label the long-form Timeline groups scenes by."
        },
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "CREATOR-01. Optional sequence label within an act."
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^msub-[a-z0-9]{6,}$"
          },
          "uniqueItems": true
        },
        "clip_file_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^file-[a-z0-9]{6,}$",
          "default": null
        },
        "picture_file_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^file-[a-z0-9]{6,}$",
          "default": null
        },
        "music_line_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^musicline-[a-z0-9]{6,}$",
          "default": null
        },
        "voice_line_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^voiceline-[a-z0-9]{6,}$",
          "default": null
        }
      }
    }
  }
}
