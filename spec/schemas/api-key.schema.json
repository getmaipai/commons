{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/api-key.schema.json",
  "title": "ApiKey",
  "description": "One personal key for voice, Home Assistant or coding. The secret and its peppered hash stay in Home and never reach this record. Home checks expiry, current controls and grants on each request. Up to 10 keys per adult, 3 per minor. Coding keys suspend when access is removed or a required piece is missing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "name",
    "scopes",
    "created_at",
    "expires_at",
    "status",
    "limits",
    "hint",
    "provenance",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^key_[a-z0-9]{6,}$"
    },
    "person_id": {
      "type": "string",
      "pattern": "^person-[a-z0-9]{6,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "turn",
          "code",
          "settings",
          "diagnose",
          "engine"
        ]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Required. Home offers 7, 30, 90 (default) or 365 days. A minor has at most 30 days."
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked",
        "suspended"
      ]
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Visible to the owner only."
    },
    "last_used_from": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "place",
        "address"
      ],
      "properties": {
        "place": {
          "type": "string",
          "enum": [
            "home_network",
            "away"
          ]
        },
        "address": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        }
      },
      "description": "Visible to the owner only. Lists show the place, never the address."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Starts at the household rate limit."
    },
    "hint": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    }
  }
}
