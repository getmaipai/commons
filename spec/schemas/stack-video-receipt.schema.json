{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-video-receipt.schema.json",
  "title": "StackVideoReceipt",
  "description": "VF-RECEIPT-01. One record per video job, written by the Stack beside the result. It belongs to the job owner's record (rule 6a): the prompt is a byte count and a hash, never its text; each input is a role and a hash, never a file name; no log, status or admin view carries it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "generate",
        "swap",
        "ingredients",
        "extend",
        "retake",
        "restyle"
      ]
    },
    "made_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "build",
        "quantization"
      ]
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "count",
        "schedule"
      ]
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "strength": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "strength",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "start",
              "end",
              "identity",
              "wardrobe",
              "voice_reference",
              "edit_source",
              "source_clip",
              "sheet",
              "reference"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "sha256",
          "bytes"
        ]
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "frames",
        "seconds"
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "audio": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "frames",
        "fps",
        "seconds",
        "audio",
        "bytes"
      ]
    },
    "delivered": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "audio": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "frames",
        "fps",
        "seconds",
        "audio",
        "bytes"
      ]
    },
    "delivered_is": {
      "enum": [
        "native",
        "finished",
        "messaging_copy"
      ]
    },
    "seed": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "ms"
        ]
      }
    },
    "peak_memory_bytes": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "finish": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "code": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation",
          "from",
          "to",
          "ok",
          "code"
        ]
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "writer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "bytes",
        "sha256"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "reason"
      ]
    },
    "take_of": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "job_id",
    "operation",
    "made_at",
    "runtime",
    "model",
    "steps",
    "adapter",
    "inputs",
    "requested",
    "native",
    "delivered",
    "delivered_is",
    "seed",
    "phases",
    "peak_memory_bytes",
    "finish",
    "prompt"
  ]
}
