{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-choices-migrate-request.schema.json",
  "title": "StackChoicesMigrateRequest",
  "description": "STACK-MODELS-PAGE-01. The body of `POST /stack/v1/choices/migrate`: Home's old per-level models, orders, feature switches and added-model records, imported once.",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "slots": {
      "description": "Home's `engines.<role>.tier.<tier>.model`.",
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "tier": {
            "type": "string",
            "enum": [
              "reduced",
              "standard",
              "boost",
              "max"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "role",
          "tier",
          "model"
        ]
      }
    },
    "orders": {
      "description": "Home's `engines.<category>.order`.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "order": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "category",
          "order"
        ]
      }
    },
    "features": {
      "description": "Home's feature switches, already as on or off.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "enabled"
        ]
      }
    },
    "added_models": {
      "description": "Home's added chat model records.",
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "licence": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "architecture": {
            "type": "string",
            "maxLength": 100
          },
          "verified": {
            "type": "boolean"
          },
          "ram_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "label",
          "repo",
          "file",
          "url",
          "revision",
          "sha256",
          "size_bytes"
        ]
      }
    }
  }
}
