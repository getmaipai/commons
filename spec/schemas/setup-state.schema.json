{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/setup-state.schema.json",
  "title": "SetupState",
  "description": "The household-scope setup progress record for one hub. Choices reference existing settings; the record does not duplicate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "steps",
    "phase",
    "engine",
    "away",
    "plan",
    "checks",
    "started_at",
    "completed_at",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id for this hub setup record."
    },
    "source": {
      "type": "string",
      "enum": [
        "wizard",
        "restore"
      ],
      "description": "How setup began; this is the record provenance."
    },
    "steps": {
      "type": "array",
      "description": "Progress for the fixed setup flow, in screen order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "welcome",
              "engine_location",
              "storage",
              "checks",
              "plan",
              "away",
              "owner",
              "face",
              "profile",
              "hello",
              "done"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "skipped",
              "deferred",
              "failed"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "$ref": "#/$defs/healthItem"
          }
        }
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "computers",
        "away",
        "meet",
        "done"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "where",
        "hardware"
      ],
      "properties": {
        "where": {
          "type": "string",
          "enum": [
            "this_computer",
            "another_computer"
          ],
          "description": "Mirrors engines.stack.where; it does not replace that setting."
        },
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "object",
          "description": "Hardware facts reported by the selected engine computer.",
          "additionalProperties": true
        }
      }
    },
    "away": {
      "type": "string",
      "enum": [
        "on",
        "later"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option",
        "tier",
        "roles"
      ],
      "properties": {
        "option": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "description": "References to per-role Setting records, never copies of their values.",
          "items": {
            "type": "string",
            "pattern": "^engines\\.[a-z_]+\\.choice$",
            "description": "The key of a per-role Setting record, not its copied value."
          },
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/healthItem"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node (7.3)."
    }
  },
  "$defs": {
    "healthItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "title",
        "text",
        "since",
        "cause"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "description": "Stable and unique per condition, `engine.crashed.chat`, `memory-pressure-warn`."
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "error",
            "warning"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "action"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "enum": [
                "restart_engine",
                "free_memory",
                "retry_download",
                "rollback_update",
                "reinstall_engine",
                "reinstall_model"
              ]
            }
          }
        }
      }
    }
  }
}
