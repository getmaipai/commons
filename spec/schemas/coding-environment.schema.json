{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/coding-environment.schema.json",
  "title": "CodingEnvironment",
  "description": "CODE-SPEC-01 (Home docs/design/local-coding-2026-10-17.md section 4.2). The setup a Code session starts from: image, setup script, plain variables the agent can read, default network and resources. Person scope, or household when an admin shares it. No secret field in this version (CODE-NETSECRET-01); a variable here is visible to the agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "name",
    "image",
    "env",
    "network",
    "resources",
    "created_at",
    "provenance",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cenv-[a-z0-9]{6,}$"
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person_id"
          ],
          "properties": {
            "person_id": {
              "type": "string",
              "pattern": "^person-[a-z0-9]{6,}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "household"
          ],
          "properties": {
            "household": {
              "const": true
            }
          }
        }
      ],
      "description": "Either a person or the household."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "The pinned sandbox image id."
    },
    "setup_script": {
      "type": "string",
      "maxLength": 20000
    },
    "env": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$",
        "maxLength": 80
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      },
      "description": "Plain variables. Visible to the agent; never put a secret here."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "hosts"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "none",
            "hosts"
          ],
          "description": "none: the sandbox reaches only the gateway. hosts: it also reaches the listed hosts through the egress proxy."
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memory_gb"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node."
    }
  }
}
