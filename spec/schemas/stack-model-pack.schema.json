{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-model-pack.schema.json",
  "title": "StackModelPack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "part": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job": {
            "enum": [
              "picture",
              "picture_edit",
              "clip",
              "clip_from_sheet",
              "restyle",
              "swap",
              "character_sheet",
              "contact_sheet"
            ]
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_seconds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "standard": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "boost": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": []
              },
              "max_references": {
                "type": "integer",
                "minimum": 0
              },
              "shapes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "landscape": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "standard": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "boost": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "max": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      }
                    },
                    "required": []
                  },
                  "portrait": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "standard": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "boost": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "max": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      }
                    },
                    "required": []
                  },
                  "square": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "standard": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "boost": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      },
                      "max": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ]
                      }
                    },
                    "required": []
                  }
                },
                "required": []
              },
              "max_words": {
                "type": "integer",
                "minimum": 0
              },
              "steps_fixed": {
                "type": "boolean"
              }
            },
            "required": []
          },
          "audiences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "adult",
                "minor"
              ]
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "boolean"
              },
              "end_picture": {
                "type": "boolean"
              },
              "sound": {
                "type": "boolean"
              },
              "keeps_likeness": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "end_picture",
              "sound",
              "keeps_likeness"
            ]
          },
          "recipe": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "peaks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "enum": [
                    "landscape",
                    "portrait",
                    "square"
                  ]
                },
                "level": {
                  "enum": [
                    "standard",
                    "boost",
                    "max"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "measured",
                    "unverified"
                  ]
                },
                "measured_on": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "shape",
                "bytes",
                "status"
              ]
            }
          }
        },
        "required": [
          "job",
          "limits",
          "audiences",
          "capabilities",
          "recipe",
          "peaks"
        ]
      }
    },
    "style_bases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "browse": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retired": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mark": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mark"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "browse"
        ]
      }
    },
    "field_map": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "version",
    "part",
    "jobs"
  ]
}
