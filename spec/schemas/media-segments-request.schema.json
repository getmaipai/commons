{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://getmaipai.github.io/shared/spec/schemas/media-segments-request.schema.json",
  "title":"MediaSegmentsRequest",
  "description":"Stack media.segments job input. Supply exactly one media source and optionally one clean reference source.",
  "type":"object","additionalProperties":false,
  "properties":{
    "url":{"type":"string","format":"uri"},"path":{"type":"string","minLength":1},
    "referenceUrl":{"type":"string","format":"uri"},"referencePath":{"type":"string","minLength":1},
    "kinds":{"type":"array","items":{"type":"string","enum":["ad","sponsor","selfpromo","intro","outro","recap","filler","bumper"]}},
    "fetch":{"type":"object","additionalProperties":false,"default":{},"properties":{"userAgent":{"type":"string","minLength":1,"maxLength":256}}},
    "keepCopy":{"type":"boolean","default":true},"expectedDurationSec":{"type":"number","exclusiveMinimum":0}
  },
  "oneOf":[{"required":["url"],"not":{"required":["path"]}},{"required":["path"],"not":{"required":["url"]}}],
  "allOf":[{"not":{"required":["referenceUrl","referencePath"]}}]
}
