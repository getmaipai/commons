{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/settings-key.schema.json",
  "title": "SettingsKey",
  "description": "One entry in the settings registry (spec/settings/keys.json) or a package manifest's config[]. See platform plan 3.2 and .github's docs/SETTINGS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "scope", "selector", "default", "label", "level", "lives_in", "honoured_by"],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "scope": {
      "type": "string",
      "enum": ["household", "person", "device"]
    },
    "selector": {
      "type": "string",
      "enum": [
        "number", "select", "text", "boolean", "duration", "time",
        "entity", "area", "person", "media", "location"
      ],
      "description": "Home Assistant's selector names (3.2)."
    },
    "range": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "options": { "type": "array", "items": { "type": "string" } },
        "options_from": { "type": "string", "minLength": 1 },
        "multiple": { "type": "boolean" },
        "allow_current": { "type": "boolean" }
      },
      "description": "Selector-specific: min/max for number, a duration unit, an option list for select, and so on. Shape depends on selector."
    },
    "layers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "enum": ["band", "household", "person"] },
      "description": "SETTINGS-LAYERS-01. The scopes a row of this key may be stored at, lowest to highest precedence: band = user defaults (Kids, Teens, Adults), household = global defaults, person = user overrides. Absent means the key is stored at its own scope only and nothing is layered."
    },
    "merge": {
      "type": "string",
      "enum": ["override", "union"],
      "description": "How layers combine. override: the most specific layer that has a value wins. union: a list key; each layer adds entries and a more specific layer may remove an entry it can see, and each entry carries who set it (spec/schemas/settings-delta.schema.json). Absent means override."
    },
    "self_service": {
      "type": "boolean",
      "description": "EASE-OF-USE-01. Absent means false. True means a person may change their own value at any age, including a child, unless an admin has locked the key for them. Declared once here for the write gate. Only comfort keys (ease.*) carry it; a safety, consent, privacy or credentials key never does (a spec test holds that)."
    },
    "user_defaults_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "child": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "teen": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "adult": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
      },
      "description": "Transitional. Where the user defaults for each audience are stored today, as band-named household keys, until they move to band:<name> rows. Each named key must exist."
    },
    "default": {},
    "label": { "type": "string", "minLength": 1 },
    "help": { "type": "string" },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": {
        "does": { "type": "string", "minLength": 1 },
        "does_child": { "type": "string", "minLength": 1 },
        "does_teen": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "what_is_stored": { "type": "string", "minLength": 1 },
        "consent_adult_self": { "type": "string", "minLength": 1 },
        "consent_teen_self": { "type": "string", "minLength": 1 },
        "consent_child_parent": { "type": "string", "minLength": 1 },
        "consent_guest": { "type": "string", "minLength": 1 },
        "options": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "option_labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Display name for each option of a select, when the raw token is not a readable name (searxng -> SearXNG)."
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "teen", "adult"],
      "properties": {
        "child": { "type": "string", "enum": ["self", "guardian"] },
        "teen": { "type": "string", "enum": ["self", "guardian"] },
        "adult": { "type": "string", "enum": ["self", "guardian"] }
      }
    },
    "band_default": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "teen", "adult"],
      "properties": {
        "child": {},
        "teen": {},
        "adult": {}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "collapsed": { "type": "boolean", "default": false },
        "order": { "type": "integer" }
      }
    },
    "level": {
      "type": "string",
      "enum": ["basic", "advanced", "expert"]
    },
    "secret": { "type": "boolean", "default": false },
    "needs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capabilities required for this key to apply."
    },
    "lives_in": {
      "type": "string",
      "description": "The package, companion, integration, or central page id that renders this key."
    },
    "honoured_by": {
      "type": "array",
      "items": { "type": "string", "enum": ["home", "bot"] },
      "minItems": 1
    }
  }
}
