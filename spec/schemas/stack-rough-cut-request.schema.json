{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-rough-cut-request.schema.json",
  "title": "StackRoughCutRequest",
  "description": "VF-ROUGHCUT-01. The request of the Stack media job `media.rough_cut`: one still per shot at its real length with its motion, each spoken line voiced, joined into one file. `audience` is the same field every Stack job carries, so the Stack's minor list applies to the speech step. A line names its shot by wrapping the spec's StackClipDialogue (`{shot_id, line}`), never by copying its fields. Home picks each speaker's voice and sends a household voice address, or none for the household default; a speaker Home flags `minor` gets no voice address from Home, and the Stack refuses a clone address for that speaker. There is no estimate field: the one estimate source is the jobs catalog. No engine or model name travels in the request. FILM-LINES-01: a shot_id may repeat in lines (at most 3 per shot, from different speakers, in the order sent, one after another).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "enum": [
        "adult",
        "minor"
      ]
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 1,
            "maxLength": 60
          },
          "picture": {
            "type": "string",
            "minLength": 1
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "motion": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Words shown at the bottom for the whole shot when the shot has no voiced line (the silent animatic's look). A voiced line is captioned with its own text."
          }
        },
        "required": [
          "id",
          "picture",
          "seconds"
        ]
      }
    },
    "lines": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 1,
            "maxLength": 60
          },
          "line": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "speaker",
              "text"
            ]
          }
        },
        "required": [
          "shot_id",
          "line"
        ]
      }
    },
    "voices": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "voice_address": {
            "type": "string",
            "minLength": 1
          },
          "minor": {
            "type": "boolean"
          }
        },
        "required": [
          "speaker"
        ]
      }
    }
  },
  "required": [
    "audience",
    "shots"
  ]
}
