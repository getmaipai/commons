{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/feed.schema.json",
  "title": "Feed",
  "description": "A household-configured news feed and its polling state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "url",
    "title",
    "publisher",
    "band",
    "poll_interval_s",
    "next_poll_at",
    "fail_count",
    "enabled",
    "hlc",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^feed-[a-z0-9]{6,}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "description": "Registrable domain of the publisher."
    },
    "band": {
      "type": "string",
      "enum": [
        "child",
        "teen",
        "adult"
      ]
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["rss", "atom", "json"],
      "description": "NEWS-00. The feed's format (JSON Feed joins RSS and Atom). Absent reads as rss."
    },
    "site_url": {
      "type": "string",
      "format": "uri",
      "description": "NEWS-00. The publisher's own home page, for the source line and the channel page."
    },
    "icon_ref": {
      "type": "string",
      "minLength": 1,
      "description": "NEWS-00. The favicon cache key; the hub serves the picture, never the publisher's address."
    },
    "topics_hint": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "description": "NEWS-00. Topic ids (spec/news/topics.json) a list package says this feed covers."
    },
    "list_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "NEWS-00. The feed list (spec/news/feed-lists.json) this feed came from."
    },
    "alerts": {
      "type": "boolean",
      "description": "NEWS-00. Reserved for FEED-ALERTS-01: this feed may raise breaking-news alerts. Nothing reads it yet."
    },
    "person_id": {
      "type": "string",
      "minLength": 1
    },
    "etag": {
      "type": "string"
    },
    "last_modified": {
      "type": "string"
    },
    "poll_interval_s": {
      "type": "integer",
      "minimum": 900
    },
    "next_poll_at": {
      "type": "string",
      "format": "date-time"
    },
    "fail_count": {
      "type": "integer",
      "minimum": 0
    },
    "quiet_until": {
      "type": "string",
      "format": "date-time"
    },
    "enabled": {
      "type": "boolean"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
