{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/robot-asset-manifest.schema.json",
  "title": "RobotAssetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "file",
    "sha256",
    "bytes",
    "licence",
    "source_url",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "kind": {
      "type": "string",
      "enum": ["model", "clip_bundle", "moves", "wheelhouse"]
    }
  }
}
