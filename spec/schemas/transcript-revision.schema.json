{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/transcriptrevision.schema.json",
  "title": "TranscriptRevision",
  "description": "CAPTION-01a: an immutable transcript revision and its operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "transcript_id",
    "n",
    "author",
    "reason",
    "ops",
    "provenance",
    "clock"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "transcript_id": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "ops": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "segment_id",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "edit_text"
              },
              "segment_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "segment_id",
              "start",
              "end"
            ],
            "properties": {
              "kind": {
                "const": "retime"
              },
              "segment_id": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "segment_id",
              "at",
              "new_segment_id"
            ],
            "properties": {
              "kind": {
                "const": "split"
              },
              "segment_id": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "new_segment_id": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "segment_ids"
            ],
            "properties": {
              "kind": {
                "const": "merge"
              },
              "segment_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "segment_id",
              "speaker"
            ],
            "properties": {
              "kind": {
                "const": "set_speaker"
              },
              "segment_id": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "speaker",
              "label"
            ],
            "properties": {
              "kind": {
                "const": "rename_speaker"
              },
              "speaker": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start",
              "end",
              "segments"
            ],
            "properties": {
              "kind": {
                "const": "replace_range"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "start",
                    "end",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    },
                    "speaker": {
                      "type": "string"
                    },
                    "words": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end",
                          "text"
                        ],
                        "properties": {
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          },
                          "text": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "model_id",
        "source_kind"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "generated",
            "imported"
          ]
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "updated_at",
        "hlc"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
          "description": "Hybrid logical clock: wall_ms:counter:node."
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node."
    }
  }
}
