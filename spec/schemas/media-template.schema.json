{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/media-template.schema.json",
  "title": "MediaTemplate",
  "description": "MEDIA-01. A reusable picture or video prompt skeleton. Blanks are filled when a creation is made; references are Library file ids. CREATOR-01: kind \"fragment\" is a short English prompt fragment (a camera, lens, light, grade and so on, in `prompt`, with its `group`) that the shot-card chips and the prompt builder read; it is not a template a person starts from. Reader rule: every template reader (the template list, the Create and Studio template pickers, the check.sh template validation) MUST skip fragment records, and only the fragment readers read them. TEMPLATE-02: a template a person saved carries owner_person_id (private unless shared_with is \"household\"), a content_rating stamp (the shared content-rating shape, copied here as a local definition like the other records) and an audience set from it by the Home side (X means adult-only, anything else all-ages); its cast is stored as cast_* blanks in the prompt only: references and styles stay empty and no model id is stored (the record is closed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "category",
    "audience",
    "prompt",
    "provenance",
    "created_at",
    "updated_at",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mtpl-[a-z0-9]{6,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "picture",
        "video",
        "fragment"
      ]
    },
    "group": {
      "type": "string",
      "enum": [
        "camera",
        "lens",
        "focal",
        "aperture",
        "framing",
        "light",
        "film_stock",
        "look",
        "grade",
        "picture_look",
        "relight",
        "angle",
        "format"
      ],
      "description": "CREATOR-01. Which vocabulary a fragment belongs to: the shot-card groups, or the picture presets picture_look, relight, angle and format (CREATOR-13). Required when kind is fragment; absent otherwise."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "default": ""
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "A category id from vocab/media-template-categories.json."
    },
    "audience": {
      "type": "string",
      "enum": [
        "all-ages",
        "adult-only"
      ],
      "description": "Strictest intended audience wins."
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^person-[a-z0-9]{6,}$",
      "description": "TEMPLATE-02. The one person who saved this template. Absent on a bundled template. A saved template is private to its owner unless shared_with says otherwise."
    },
    "shared_with": {
      "type": "string",
      "enum": [
        "household"
      ],
      "description": "TEMPLATE-02. Who else may use this saved template: the literal \"household\" (the same value the share record uses). Absent means private to owner_person_id."
    },
    "content_rating": {
      "$ref": "#/$defs/content_rating"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "description": "Prompt skeleton with named blanks in braces."
    },
    "references": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^file-[a-z0-9]{6,}$"
      },
      "default": [],
      "description": "Library file ids only."
    },
    "styles": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lora-[a-z0-9]{6,}$"
      },
      "default": []
    },
    "aspect": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "1:1",
        "3:2",
        "2:3",
        "16:9",
        "9:16",
        null
      ],
      "default": null
    },
    "transparent": {
      "type": "boolean",
      "default": false
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fragment"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "group"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "owner_person_id": {
            "type": "string"
          }
        },
        "required": [
          "owner_person_id"
        ]
      },
      "then": {
        "properties": {
          "references": {
            "maxItems": 0
          },
          "styles": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "content_rating": {
      "description": "The one stamp every rated item and result carries. It sits beside content-ceiling.schema.json, which governs the register of a generated reply per band and is unchanged. A viewer's ceiling is a rank from 0 to 4 in Home's design.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "G",
            "PG",
            "PG-13",
            "R",
            "X",
            "Prohibited",
            "Unrated"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "given",
            "declared",
            "worked_out"
          ],
          "description": "given means an outside label such as a film rating, explicit flag, or site list; declared means the feature that made the content says what it can only make; worked_out means one of our own raters decided."
        },
        "rater": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The rater id."
        },
        "rater_version": {
          "type": "integer",
          "minimum": 1
        },
        "rated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "swearing",
              "drugs",
              "gambling",
              "gore",
              "sexual",
              "minor_line",
              "scary",
              "self_harm"
            ]
          },
          "description": "The first six are Home's content-policy protection kinds; scary and self_harm come from the design note."
        },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "system",
            "value"
          ],
          "description": "The outside label this stamp was mapped from."
        }
      },
      "required": [
        "level",
        "source",
        "rater",
        "rater_version",
        "rated_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "given"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "label"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "Prohibited"
              }
            },
            "required": [
              "level"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "contains": {
                  "const": "minor_line"
                }
              }
            },
            "required": [
              "reasons"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "Unrated"
              }
            },
            "required": [
              "level"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
