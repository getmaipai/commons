{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/news-item.schema.json",
  "title": "NewsItem",
  "description": "One canonical item ingested from a household news feed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feed_id",
    "url",
    "canonical_url",
    "title",
    "summary",
    "fetched_at",
    "publisher",
    "lang",
    "band_ok",
    "hlc",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^news-[a-z0-9]{6,}$"
    },
    "feed_id": {
      "type": "string",
      "pattern": "^feed-[a-z0-9]{6,}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "minLength": 2
    },
    "story_id": {
      "type": "string",
      "pattern": "^story-[a-z0-9]{6,}$"
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "description": "NEWS-00. Topic ids from spec/news/topics.json; empty when the classifier is unsure."
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "NEWS-00. The picture address the feed itself named (media:content, media:thumbnail, an image enclosure or the first picture in the feed's own content), never one read from a fetched page. Fetched only when a screen shows the story."
    },
    "image_ref": {
      "type": ["string", "null"],
      "description": "NEWS-00. The picture cache key once a screen asked for it; null until then."
    },
    "content_ref": {
      "type": ["string", "null"],
      "description": "NEWS-00. The cached article block list in the knowledge store; null until needed."
    },
    "content_source": {
      "type": "string",
      "enum": ["feed", "fetched", "archived", "teaser"],
      "description": "NEWS-00. Where the article text came from: the feed's own text, one fetch of the page, an archived copy, or only the feed's teaser."
    },
    "reading_s": {
      "type": "integer",
      "minimum": 0,
      "description": "NEWS-00. Estimated reading time in seconds, from the text."
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "body_cached_until": {
      "type": "string",
      "format": "date-time"
    },
    "band_ok": {
      "type": "string",
      "enum": [
        "child",
        "teen",
        "adult"
      ]
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
