{
  "description": "Supplied coordinates skip geocoding, and the forecast result retains its values and place label.",
  "recipe": {
    "id": "weather-coordinates",
    "inputs": [
      {
        "name": "place",
        "selector": "text"
      },
      {
        "name": "latitude",
        "selector": "number"
      },
      {
        "name": "longitude",
        "selector": "number"
      }
    ],
    "steps": [
      {
        "op": "fetch",
        "as": "geo",
        "url": "https://geocoding-api.open-meteo.com/v1/search?name={place}",
        "unless_set": "latitude"
      },
      {
        "op": "pick",
        "as": "latitude",
        "from": "geo",
        "path": "results.0.latitude",
        "unless_set": "latitude"
      },
      {
        "op": "pick",
        "as": "longitude",
        "from": "geo",
        "path": "results.0.longitude",
        "unless_set": "latitude"
      },
      {
        "op": "pick",
        "as": "place",
        "from": "geo",
        "path": "results.0.name",
        "unless_set": "latitude"
      },
      {
        "op": "fetch",
        "as": "wx",
        "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,weather_code"
      },
      {
        "op": "format",
        "as": "reply",
        "text": "Forecast for {place}: {wx.current.temperature_2m} degrees, code {wx.current.weather_code}."
      },
      {
        "op": "pick",
        "as": "temperature",
        "from": "wx",
        "path": "current.temperature_2m"
      },
      {
        "op": "pick",
        "as": "weather_code",
        "from": "wx",
        "path": "current.weather_code"
      },
      {
        "op": "format",
        "as": "reply",
        "text": "Forecast for {place}: {temperature} degrees, code {weather_code}."
      }
    ]
  },
  "inputs": {
    "place": "Home",
    "latitude": 0,
    "longitude": -122.33
  },
  "host_setup": {
    "fetch": {
      "https://api.open-meteo.com/v1/forecast?latitude=0&longitude=-122.33&current=temperature_2m,weather_code": {
        "current": {
          "temperature_2m": 65,
          "weather_code": 1
        }
      }
    }
  },
  "expected": {
    "reply": {
      "text": "Forecast for Home: 65 degrees, code 1.",
      "speech": "Forecast for Home: 65 degrees, code 1."
    },
    "actions": [],
    "scheduled_jobs": [],
    "home_calls": [],
    "memory_added": []
  }
}
