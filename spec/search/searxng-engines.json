  "groups": [
    {
      "id": "general",
      "label": "General web",
      "description": "Search the web for everyday questions.",
      "needed_by": ["web search"],
      "default_on": true,
      "locked": true,
      "engines": [
        {"name":"brave","operator":"Brave","country":"United States","safe_search":true,"privacy_flag":false},
        {"name":"duckduckgo","operator":"DuckDuckGo","country":"United States","safe_search":true,"privacy_flag":false},
        {"name":"bing","operator":"Microsoft","country":"United States","safe_search":true,"privacy_flag":false},
        {"name":"startpage","operator":"Startpage","country":"Netherlands","safe_search":true,"privacy_flag":false},
        {"name":"mojeek","operator":"Mojeek","country":"United Kingdom","safe_search":true,"privacy_flag":false}
      ]
    },
    {
      "id": "reference",
      "label": "Wikipedia and reference",
      "description": "Search Wikipedia and related references.",
      "needed_by": ["web search", "people and places"],
      "default_on": true,
      "locked": true,
      "engines": [
        {"name":"wikipedia","operator":"Wikimedia Foundation","country":"International","safe_search":true,"privacy_flag":false},
