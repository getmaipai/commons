{
  "type": "page",
  "id": "media-parity-2",
  "title": "Playlist",
  "body": [
    {
      "type": "search",
      "label": "Search",
      "state": "q",
      "suggest": {
        "bind": {
          "source": "package",
          "path": "suggest",
          "params": {
            "q": "$state.q"
          }
        },
        "item_key_field": "key",
        "item_label_field": "label",
        "max": 6,
        "min_chars": 2
      },
      "recents": {
        "source": "package",
        "path": "recent-searches"
      }
    },
    {
      "type": "track_rows",
      "bind": {
        "source": "package",
        "path": "playlist-tracks"
      },
      "label": "Playlist tracks",
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{artist}",
      "on_play": {
        "play": {
          "media_id": "{id}"
        }
      },
      "reorder": {
        "call": {
          "call": {
            "target": "/api/plugins/music/playlists/reorder",
            "method": "POST"
          }
        },
        "id_param": "ids"
      },
      "row_actions": [
        {
          "icon": "trash",
          "label": "Remove {title}",
          "action": {
            "confirm": {
              "prompt": "Remove {title}?",
              "on_confirm": {
                "call": {
                  "target": "/api/plugins/music/playlists/items/{id}",
                  "method": "DELETE"
                }
              },
              "status": {
                "source": "package",
                "path": "remove-status"
              }
            }
          }
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Unwatched",
      "bind": {
        "source": "package",
        "path": "videos"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_media_field": "cover",
      "item_badge_field": "unplayed",
      "item_badge_presentation": "dot",
      "orientation": "vertical",
      "reorder": {
        "call": {
          "call": {
            "target": "/api/plugins/videos/playlists/reorder"
          }
        },
        "id_param": "ids"
      }
    },
    {
      "type": "widget_tiles",
      "bind": {
        "source": "route",
        "path": "/api/widgets"
      }
    },
    {
      "type": "list",
      "bind": {
        "source": "package",
        "path": "playlist-people"
      },
      "item_key_field": "id",
      "item_label_field": "name",
      "hide_when_empty": true,
      "row_action": {
        "icon": "plus",
        "label": "Save {name}",
        "action": {
          "call": {
            "target": "/api/plugins/music/playlists/save",
            "args": {
              "id": "{id}"
            },
            "success_label": "Saved"
          }
        }
      }
    }
  ]
}
