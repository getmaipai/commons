  "not_placed": [
    {
      "scope": "household",
      "group": "household.voice",
      "reason": "Home's default voice is chosen on the Voices page in Settings, next to the voices it can pick from (a view, not a settings card)."
    },
    {
      "scope": "person",
      "group": "person.topics",
      "reason": "A parent sets a child's sensitive-subject levels on that child's Family page; a settings area only reads and writes the viewer's own scope, never another person's, and a teen has no person-level topic key at all."
    },
    {
      "scope": "person",
      "group": "person.allowance",
      "reason": "A parent sets a child's daily allowances on that child's Family page; a settings area only reads and writes the viewer's own scope, never another person's."
    },
    {
      "scope": "person",
      "group": "person.storage",
      "reason": "An admin sets a person's quota from Users and Storage; it is never the viewer's own to change, and no settings route takes a person id."
    },
    {
      "scope": "person",
      "group": "person.coding",
      "reason": "An admin sets coding grants and limits on the person's Family page. The account view shows what the grant allows."
    },
    {
      "scope": "person",
      "group": "profile.appearance.internal",
      "reason": "Pinned app order and checklist dismissal are internal UI state and are not user-facing settings."
    }
  ],
